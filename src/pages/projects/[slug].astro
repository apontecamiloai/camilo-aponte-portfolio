---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, index) => {
    const previous = projects[index - 1];
    const next = projects[index + 1];

    return {
      params: { slug: project.data.slug },
      props: {
        project,
        previous: previous ? { title: previous.data.title, href: `/projects/${previous.data.slug}` } : undefined,
        next: next ? { title: next.data.title, href: `/projects/${next.data.slug}` } : undefined,
      },
    };
  });
}

const { project, previous, next } = Astro.props;
const { Content, headings } = await render(project);
---

<ProjectLayout project={project} headings={headings} previous={previous} next={next}>
  <Content />
</ProjectLayout>
