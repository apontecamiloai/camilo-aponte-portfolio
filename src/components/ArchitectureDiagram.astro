---
interface Props {
  steps: string[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<figure class="my-8 rounded-md border border-border-subtle bg-navy-850 p-6 shadow-card">
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:gap-3 lg:grid-cols-6">
    {
      steps.map((step, index) => (
        <div class="flex min-w-0 flex-col items-center justify-center gap-1 rounded border border-border-muted bg-navy-950 px-2 py-3 text-center font-mono text-sm text-ink-100">
          {index > 0 && (
            <span class="text-xs text-accent-400" aria-hidden="true">
              &rarr;
            </span>
          )}
          <span class="break-words">{step}</span>
        </div>
      ))
    }
  </div>
  {caption && <figcaption class="mt-4 text-center text-xs text-ink-400">{caption}</figcaption>}
</figure>
