---
import SocialLinks from './SocialLinks.astro';
import { footerNav } from '../data/navigation';
import { profile } from '../data/profile';
---

<footer class="border-t border-border-muted">
  <div class="mx-auto max-w-content px-6 py-12 md:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <p class="font-mono text-sm text-ink-100">{profile.name}</p>
        <p class="mt-1 text-sm text-ink-400">{profile.role} · {profile.location}</p>
        <p class="mt-1 text-sm text-ink-400">{profile.workMode}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            footerNav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink-400 hover:text-accent-400">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <SocialLinks />
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border-muted pt-6 text-xs text-ink-400 md:flex-row md:items-center md:justify-between">
      <p>&copy; {new Date().getFullYear()} {profile.name}. All rights reserved.</p>
      <p>Some implementation details have been generalized to protect confidential information.</p>
    </div>
  </div>
</footer>
