---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="my-6 rounded-md border-l-2 border-accent-500 bg-navy-850 p-5 shadow-card">
  <p class="font-mono text-xs uppercase tracking-widest text-accent-400">Key decision</p>
  <p class="mt-1 text-base font-semibold text-ink-100">{title}</p>
  <div class="prose-body mt-3">
    <slot />
  </div>
</div>
