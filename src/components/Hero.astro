---
import { profile } from '../data/profile';
import fs from 'node:fs';
import path from 'node:path';

const resumeFilePath = path.join(process.cwd(), 'public', 'resume', profile.resumeFileName);
const resumeExists = fs.existsSync(resumeFilePath);
---

<section class="relative border-b border-border-muted">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-500/40 to-transparent"></div>
  <div class="mx-auto max-w-content px-6 py-12 md:px-8 md:py-16">
    <p class="font-mono text-xl text-accent-400 md:text-2xl">{profile.name} · {profile.role}</p>
    <p class="mt-2 font-mono text-xs uppercase tracking-widest text-ink-500 md:text-sm">{profile.positioning}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-ink-100 md:text-6xl">
      I turn fragmented operations into production AI systems.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-400">
      At Search Atlas I built the AI Automation function from zero — no governance model, no connectors, no
      conversational architecture. Fourteen months in: Fin AI's resolution rate has moved from roughly 30% to 70%,
      and the knowledge base it draws on has grown from 250 to 2,056 structured, AI-ready articles.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        href="/projects"
        class="rounded bg-accent-500 px-5 py-2.5 text-sm font-medium text-ink-900 transition-colors hover:bg-accent-400"
      >
        View Projects
      </a>
      <a
        href={resumeExists ? profile.resumeUrl : '/resume'}
        download={resumeExists}
        class="rounded border border-border-muted px-5 py-2.5 text-sm font-medium text-ink-100 transition-colors hover:border-accent-400 hover:text-accent-400"
      >
        Download Resume (PDF)
      </a>
      <a
        href={profile.socials[0]?.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-ink-400 underline decoration-border-muted underline-offset-4 hover:text-accent-400"
      >
        Connect on LinkedIn
      </a>
    </div>
  </div>
</section>
