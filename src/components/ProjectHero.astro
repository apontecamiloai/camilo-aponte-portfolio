---
import TechTag from './TechTag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, category, role, organization, startDate, endDate, status, technologies } = project.data;

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', timeZone: 'UTC' };
const dateRange = `${startDate.toLocaleDateString('en-US', dateFormat)} – ${
  status === 'ongoing' ? 'Present' : endDate ? endDate.toLocaleDateString('en-US', dateFormat) : 'Present'
}`;
---

<header class="border-b border-border-muted">
  <div class="mx-auto max-w-content px-6 py-14 md:px-8">
    <p class="font-mono text-xs uppercase tracking-widest text-accent-400">{category}</p>
    <h1 class="mt-3 text-3xl font-semibold text-ink-100 md:text-4xl">{title}</h1>

    <dl class="mt-6 grid grid-cols-2 gap-6 text-sm md:grid-cols-4">
      <div>
        <dt class="font-mono text-xs uppercase tracking-widest text-ink-500">Role</dt>
        <dd class="mt-1 text-ink-100">{role}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-widest text-ink-500">Organization</dt>
        <dd class="mt-1 text-ink-100">{organization}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-widest text-ink-500">Timeline</dt>
        <dd class="mt-1 text-ink-100">{dateRange}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-widest text-ink-500">Status</dt>
        <dd class="mt-1 capitalize text-ink-100">{status}</dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-2">
      {technologies.map((tech) => <TechTag label={tech} />)}
    </div>
  </div>
</header>
