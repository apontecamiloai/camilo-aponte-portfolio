---
interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  level?: 'h1' | 'h2' | 'h3';
}

const { eyebrow, heading, description, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class="max-w-2xl">
  {
    eyebrow && (
      <div class="flex items-center gap-3">
        <p class="font-mono text-xs uppercase tracking-widest text-accent-400">{eyebrow}</p>
        <span class="h-px flex-1 max-w-12 bg-border-muted" aria-hidden="true"></span>
      </div>
    )
  }
  <Tag class="mt-3 text-2xl font-semibold tracking-tight text-ink-100 md:text-3xl">{heading}</Tag>
  {description && <p class="mt-3 text-base leading-relaxed text-ink-400">{description}</p>}
</div>
