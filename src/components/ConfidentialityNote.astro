---
interface Props {
  variant?: 'full' | 'short';
}

const { variant = 'full' } = Astro.props;
---

{
  variant === 'full' ? (
    <p class="rounded-md border border-border-subtle bg-navy-850 p-4 text-sm leading-relaxed text-ink-400 shadow-card">
      This case study describes architecture, decisions, and outcomes at a high level. Proprietary implementation
      details, customer data, credentials, internal source code, and sensitive operational information are
      intentionally omitted.
    </p>
  ) : (
    <p class="text-xs text-ink-400">Some implementation details have been generalized to protect confidential information.</p>
  )
}
