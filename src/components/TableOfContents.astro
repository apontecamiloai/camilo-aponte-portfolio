---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <nav aria-label="Table of contents" class="rounded-md border border-border-subtle bg-navy-850 p-5 shadow-card">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-400">On this page</p>
      <ul class="mt-3 space-y-2">
        {items.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="text-sm text-ink-400 hover:text-accent-400">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
