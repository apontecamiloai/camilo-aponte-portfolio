---
interface Props {
  value: string;
  label: string;
  description?: string;
}

const { value, label, description } = Astro.props;
---

<div class="group rounded-md border border-border-subtle bg-navy-850 p-5 shadow-card transition-shadow duration-200 hover:shadow-card-hover">
  <p class="font-mono text-2xl font-semibold tabular-nums text-ink-100 md:text-3xl">{value}</p>
  <p class="mt-2 h-px w-8 bg-border-muted transition-colors duration-200 group-hover:bg-accent-400" aria-hidden="true"></p>
  <p class="mt-2 text-sm text-ink-400">{label}</p>
  {description && <p class="mt-1 text-xs text-ink-500">{description}</p>}
</div>
